{
  "name": "txt-to-handwriting",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:sitemap && vite build && npm run generate:localized-pages",
    "preview": "vite preview",
    "typecheck:components": "tsc -p tsconfig.components.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "benchmark": "tsx scripts/runBenchmark.ts",
    "validate:filesize": "tsx scripts/validateFileSize.ts",
    "test:performance": "npm run validate:filesize && npm test -- performanceBenchmark.test.ts",
    "generate:sitemap": "node scripts/generateSitemap.js",
    "generate:localized-pages": "node scripts/generateLocalizedPages.js",
    "submit:indexnow": "node scripts/indexNow.js"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.1",
    "react-image-crop": "^11.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.11",
    "canvas": "^3.2.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
